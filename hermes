#!/usr/bin/env bash
# HENRY hermes wrapper — project-scoped agent
# Generated by hermesify.py — do not hand-edit the header
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export HERMES_HOME="$SCRIPT_DIR/.hermes"
export HERMES_PROJECT_NAME="henry-consulting"

# Make sure the session dir exists
mkdir -p "$HERMES_HOME/sessions"

# Point hermes at the global skills library (without creating a symlink that
# would confuse Windows Obsidian's scanner). Create an on-demand symlink right
# before running, then clean it up on exit.
if [[ ! -e "$HERMES_HOME/skills" ]]; then
    ln -sf "/home/whitt/.hermes/skills" "$HERMES_HOME/skills" 2>/dev/null || true
    _CREATED_SKILL_LINK=1
fi
trap 'if [[ "${_CREATED_SKILL_LINK:-0}" == "1" && -L "$HERMES_HOME/skills" ]]; then rm -f "$HERMES_HOME/skills"; fi' EXIT

# Activate the global hermes venv so we use one Python install
if [[ -f "/home/whitt/.hermes/hermes-agent/venv/bin/activate" ]]; then
    source "/home/whitt/.hermes/hermes-agent/venv/bin/activate"
fi

# Run hermes with project context
exec "/home/whitt/.hermes/hermes-agent/venv/bin/hermes" "$@"
